{
  "name": "htmlforpdf",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc -p . --noEmit && tsc -p tests/tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "prepare": "husky install",
    "lint": "eslint '{src,tests}/**/*.{ts,js}'",
    "lint:fix": "eslint '{src,tests}/**/*.{ts,js}' --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "worker": "node dist/worker/pdfWorker.js",
    "dev:worker": "tsx watch src/worker/pdfWorker.ts",
    "build": "tsc -p ."
  },
  "keywords": [],
  "author": "Edvaldo Lima",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@vinejs/vine": "^4.3.0",
    "amqplib": "^0.10.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "playwright": "^1.58.2",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.0",
    "@commitlint/config-conventional": "^17.6.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.17",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^6.6.0",
    "@typescript-eslint/parser": "^6.6.0",
    "eslint": "^8.44.0",
    "husky": "^8.0.3",
    "prettier": "^2.8.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "qs": "^6.16.2"
  }
}
