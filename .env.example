PORT=3000
# Required: generate with `openssl rand -hex 32`; send as X-API-Key.
API_KEY=
# Docker: set to rabbitmq to start the bundled broker; leave empty for an external one.
COMPOSE_PROFILES=
# External mode: replace this URL with your existing broker address.
# Bundled mode: use the rabbitmq hostname and credentials matching the values below.
RABBITMQ_URL=amqp://htmlforpdf:change-me-local-only@rabbitmq:5672
# Bundled broker only. Change the example password before deployment.
RABBITMQ_USER=htmlforpdf
RABBITMQ_PASSWORD=change-me-local-only
# Ports exposed only on the Docker host's loopback interface.
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# New topology: do not reuse a queue declared with different arguments.
PDF_QUEUE_NAME=html_for_pdf_job_v2
WORKER_CONCURRENCY=1
MAX_CONCURRENT_RENDERS=2
RENDER_TIMEOUT_MS=45000
WEBHOOK_TIMEOUT_MS=15000
MAX_PDF_BYTES=20971520
MAX_NETWORK_BYTES=52428800
JOB_MAX_ATTEMPTS=3
QUEUE_MAX_LENGTH=10000
RATE_LIMIT_PER_MINUTE=30
# Optional HMAC authentication of delivered PDFs.
WEBHOOK_SECRET=
LOG_LEVEL=info
